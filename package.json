{
  "name": "simpleshell",
  "productName": "SimpleShell",
  "version": "0.5.7",
  "description": "A Simple Cross-Platform Electron SSH Terminal",
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "postinstall": "node scripts/patch-xterm.js",
    "start": "node scripts/prepare-native-services.js && electron-forge start",
    "package": "node scripts/prepare-native-services.js && electron-forge package",
    "make": "node scripts/prepare-native-services.js && node scripts/prepare-winstaller-vendor.js && electron-forge make",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
