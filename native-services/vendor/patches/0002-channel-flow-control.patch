+/// Session-side sender of a channel's message queue. `send` never waits.
+#[derive(Debug, Clone)]
+pub struct ChannelSender(UnboundedSender<ChannelMsg>);
+
+impl ChannelSender {
+    pub async fn send(
+        &self,
