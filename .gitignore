.cursorignore

# 忽略所有.env文件
.env*

# 忽略所有.env.local文件
.env.local*

# 配置文件
config.json
config.json.tmp-*
config-backups/
diagnostics/
temp/

# vscode
.vscode

# webpack 构建产物与缓存
.webpack/
.webpack_cache/

# Inno Setup scripts should stay in repo; generated installers should not.
installer/*
!installer/*.iss

# Native-services source stays in repo; build outputs do not.
native-services/bin/*
native-services/**/target/

# Native profiling, downloaded crate archives and formatter backups.
native-services/**/*.profraw
native-services/**/*.profdata
native-services/**/*.crate
native-services/**/*.rs.bk
native-services/**/benchmark-results*.json

# Registry-generated metadata is not needed for vendored library builds.
# Keep Cargo.lock files for reproducible application builds and vendor tests.
native-services/vendor/**/Cargo.toml.orig
native-services/vendor/**/.cargo_vcs_info.json
native-services/vendor/**/.cargo-ok

# Release metadata generated next to packaged artifacts.
SHA256SUMS
release-manifest.json

# 其他常见构建/打包产物（保险兜底）
*.asar
*.blockmap
*.nupkg
*.exe
*.msi
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.snap
*.zip
*.pdb

# IDE
.idea/

.claude/

